{
  "name": "Credit Scoring Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "credit-score",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook - Credit Application",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "credit-score-webhook"
    },
    {
      "parameters": {
        "functionCode": "// Validate incoming credit application data\nconst requiredFeatures = [\n  'utilisation', 'dpd_days', 'cash_credit_ratio', 'cash_debit_ratio',\n  'inbound_cheque_bounce_count', 'inbound_cheque_bounce_amt',\n  'outbound_cheque_bounce_count', 'outbound_cheque_bounce_amt',\n  'total_amt_credit', 'total_amt_debit', 'no_of_banks'\n];\n\nconst data = items[0].json.body;\n\n// Check for missing fields\nconst missing = requiredFeatures.filter(f => !(f in data));\nif (missing.length > 0) {\n  throw new Error(`Missing required features: ${missing.join(', ')}`);\n}\n\n// Validate numeric values and ranges\nfor (const feature of requiredFeatures) {\n  const value = parseFloat(data[feature]);\n  if (isNaN(value) || !isFinite(value)) {\n    throw new Error(`Feature '${feature}' must be numeric, got: ${data[feature]}`);\n  }\n}\n\n// Range validations\nif (data.utilisation < 0 || data.utilisation > 100) {\n  throw new Error('utilisation must be between 0 and 100');\n}\n\nif (data.dpd_days < 0) {\n  throw new Error('dpd_days cannot be negative');\n}\n\nif (data.no_of_banks < 0) {\n  throw new Error('no_of_banks cannot be negative');\n}\n\n// Prepare clean data for ML service\nconst cleanData = {\n  customer_id: data.customer_no || 'N/A',\n  features: {\n    utilisation: parseFloat(data.utilisation),\n    dpd_days: parseFloat(data.dpd_days),\n    cash_credit_ratio: parseFloat(data.cash_credit_ratio),\n    cash_debit_ratio: parseFloat(data.cash_debit_ratio),\n    inbound_cheque_bounce_count: parseFloat(data.inbound_cheque_bounce_count),\n    inbound_cheque_bounce_amt: parseFloat(data.inbound_cheque_bounce_amt),\n    outbound_cheque_bounce_count: parseFloat(data.outbound_cheque_bounce_count),\n    outbound_cheque_bounce_amt: parseFloat(data.outbound_cheque_bounce_amt),\n    total_amt_credit: parseFloat(data.total_amt_credit),\n    total_amt_debit: parseFloat(data.total_amt_debit),\n    no_of_banks: parseFloat(data.no_of_banks)\n  }\n};\n\nreturn { json: cleanData };"
      },
      "id": "function-validate",
      "name": "Validate Input",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:5064/predict",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "http-ml-service",
      "name": "ML Service - Get Prediction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "functionCode": "// Calculate risk bucket and prepare decision data\nconst mlResponse = items[0].json;\nconst probability = mlResponse.probability;\nconst customer_id = mlResponse.customer_id || $node['Validate Input'].json.customer_id;\n\n// Determine risk bucket\nlet bucket;\nif (probability >= 0.90) {\n  bucket = 'Very High';\n} else if (probability >= 0.80) {\n  bucket = 'High';\n} else if (probability >= 0.70) {\n  bucket = 'Moderate';\n} else if (probability >= 0.50) {\n  bucket = 'Low';\n} else {\n  bucket = 'No Risk';\n}\n\n// Determine decision status\nlet status;\nif (probability >= 0.80) {\n  status = 'REJECT';\n} else if (probability >= 0.70) {\n  status = 'REVIEW';\n} else if (probability >= 0.50) {\n  status = 'CONDITIONAL_ACCEPT';\n} else {\n  status = 'ACCEPT';\n}\n\nreturn {\n  json: {\n    customer_id: customer_id,\n    probability: probability,\n    probability_percentage: `${(probability * 100).toFixed(2)}%`,\n    bucket: bucket,\n    status: status,\n    shap_values: mlResponse.shap_values || [],\n    features: $node['Validate Input'].json.features,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "function-bucket",
      "name": "Calculate Risk Bucket",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "number": [
                  {
                    "value1": "={{ $json.probability }}",
                    "value2": 0.8,
                    "operation": "largerEqual"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "reject"
            },
            {
              "conditions": {
                "number": [
                  {
                    "value1": "={{ $json.probability }}",
                    "value2": 0.7,
                    "operation": "largerEqual"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "review"
            },
            {
              "conditions": {
                "number": [
                  {
                    "value1": "={{ $json.probability }}",
                    "value2": 0.5,
                    "operation": "largerEqual"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "conditional"
            },
            {
              "conditions": {
                "number": [
                  {
                    "value1": "={{ $json.probability }}",
                    "value2": 0.5,
                    "operation": "smaller"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "accept"
            }
          ]
        }
      },
      "id": "switch-decision",
